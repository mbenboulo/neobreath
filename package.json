{
  "name": "neobreath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "anim:sync": "npm run tokens:sync && node scripts/sync-anim.mjs",
    "anim:check": "npm run tokens:check && node scripts/sync-anim.mjs --check",
    "assets:check": "node scripts/check-assets.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "verify": "npm run encoding:check && npm run assets:check && npm run audit:contrast && npm run anim:check",
    "shoot": "node scripts/shoot.mjs",
    "metadata:report": "node scripts/report-metadata.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "framer-motion": "^12.23.26",
    "next": "16.0.10",
    "nodemailer": "^7.0.11",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
