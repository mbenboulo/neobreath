# Environment variables for NeoBreath.
#
# Copy to `.env.local` for development. `.env.local` is git-ignored.
# None of these are secrets that belong in the repository.

# ── Required in production ───────────────────────────────────────────────────
#
# The canonical origin, used for canonical URLs, Open Graph image URLs and
# sitemap.xml. Without it the build falls back to http://localhost:3000 and every
# social preview and sitemap entry points at localhost.
#
#   NEXT_PUBLIC_SITE_URL=https://neobreath.example
#
NEXT_PUBLIC_SITE_URL=

# ── Contact form ─────────────────────────────────────────────────────────────
#
# Used by app/api/contact/route.ts to send the support form by email.
# For Gmail, EMAIL_PASS must be an App Password, not the account password,
# if two-factor authentication is enabled.
EMAIL_USER=
EMAIL_PASS=
